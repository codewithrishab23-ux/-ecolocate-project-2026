# ============================================================================
# EcoLocate - Environment Configuration Example
# Duplicate this file to .env and customize with your database credentials
# ============================================================================

# Security Key for Flask Session Signing & CSRF
# Generate in python: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ecolocate_phase8_production_secret_key_change_me_in_prod

# ----------------------------------------------------------------------------
# Option A: Local Development Database (XAMPP / Local MySQL)
# ----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=ewaste_db
DB_POOL_SIZE=25
SESSION_COOKIE_SECURE=False

# ----------------------------------------------------------------------------
# Option B: Cloud Database (e.g. Aiven MySQL / TiDB Serverless / Railway)
# ----------------------------------------------------------------------------
# DB_HOST=mysql-xxxxxxxx-service.aivencloud.com
# DB_PORT=14884
# DB_USER=avnadmin
# DB_PASSWORD=your_aiven_cloud_password
# DB_NAME=ewaste_db
# DB_POOL_SIZE=10
# DB_SSL_CA=/path/to/ca.pem
# SESSION_COOKIE_SECURE=True

# Flask App Core Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
